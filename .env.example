# Copy to .env and fill in. .env is gitignored.
# Development key from https://developer.riotgames.com (expires every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Your account(s), comma-separated gameName#tagLine. Used as the default --riot-id everywhere.
RIOT_IDS=yourname#na1
# The subset shown on the published page (hands-diff export). Never falls back to RIOT_IDS.
PUBLISH_RIOT_IDS=yourname#na1
# Tier each account is ranked against by default, name#tag:TIER (CHALLENGER, GRANDMASTER/GM, MASTER, DIAMOND).
# Use the tier you actually play in (your MMR), which can differ from your shown rank. Unset = page default.
COMPARE_TIERS=yourname#na1:MASTER
